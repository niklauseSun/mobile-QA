{
  "name": "android-gesture-smoke",
  "platform": "android",
  "runtime": "android-native",
  "steps": [
    {
      "action": "assertText",
      "text": "Home",
      "timeoutMs": 15000
    },
    {
      "action": "swipe",
      "direction": "up",
      "percent": 0.8,
      "durationMs": 600
    },
    {
      "action": "scroll",
      "selector": {
        "strategy": "accessibilityId",
        "value": "settings.logout"
      },
      "direction": "up",
      "maxScrolls": 4,
      "timeoutMs": 10000
    },
    {
      "action": "longPress",
      "selector": {
        "strategy": "accessibilityId",
        "value": "feed.item.1"
      },
      "durationMs": 1200
    },
    {
      "action": "hideKeyboard"
    },
    {
      "action": "deepLink",
      "url": "demo://orders/123",
      "appIdentifier": "com.example.app",
      "waitForLaunch": true
    },
    {
      "action": "screenshot",
      "name": "gesture-smoke"
    }
  ]
}
